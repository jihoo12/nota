{
  "name": "note-app",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "build:desktop": "npm run build",
    "start": "electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "@types/prismjs": "^1.26.6",
    "katex": "^0.17.0",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.0",
    "electron": "^42.3.0",
    "typescript": "^5.2.0",
    "vite": "^8.0.14",
    "wait-on": "^9.0.10"
  }
}
